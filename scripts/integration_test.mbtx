import {
  "moonbitlang/async@0.20.2",
  "moonbitlang/async@0.20.2/process" @process,
}

async fn check_cli(
  label : String,
  args : Array[String],
  should_succeed : Bool,
  expected_output? : String,
) -> Unit {
  let (status, stdout, stderr) = @process.collect_output("moon", args, cwd=".")
  if should_succeed && status != 0 {
    fail("CLI integration failed: " + label + "\n" + stderr.text())
  }
  if !should_succeed && status == 0 {
    fail("CLI unexpectedly succeeded: " + label)
  }
  if expected_output is Some(expected) && !stdout.text().contains(expected) {
    fail("CLI output did not contain expected text for " + label + ": " + stdout.text())
  }
  println("PASS " + label)
}

async fn main {
  check_cli(
    "minimal on-disk fixture with multiple signals",
    ["run", "cmd/moondbc", "--", "validate", "testdata/minimal.dbc"],
    true,
  )
  check_cli(
    "common header and multiline NS_ fixture",
    ["run", "cmd/moondbc", "--", "validate", "testdata/common_header.dbc"],
    true,
  )
  check_cli(
    "unsupported semantic fixture is rejected",
    [
      "run", "cmd/moondbc", "--", "validate",
      "testdata/unsupported_semantics.dbc",
    ],
    false,
  )
  check_cli(
    "inspect reads message and signal schema",
    ["run", "cmd/moondbc", "--", "inspect", "testdata/minimal.dbc"],
    true,
  )
  check_cli(
    "inspect preserves scoped comments and escapes quotes",
    ["run", "cmd/moondbc", "--", "inspect", "testdata/common_header.dbc"],
    true,
    expected_output="CM_ \"Synthetic network comment with an escaped quote: \\\"ready\\\"\";",
  )
  check_cli(
    "decode executes against disk schema",
    [
      "run", "cmd/moondbc", "--", "decode", "testdata/minimal.dbc",
      "--frame-id", "256", "--data", "A0BC",
    ],
    true,
    expected_output="IntelValue: raw=3018, physical=1508",
  )
  check_cli(
    "encode executes against disk schema",
    [
      "run", "cmd/moondbc", "--", "encode", "testdata/minimal.dbc",
      "--message", "Minimal", "--signal", "IntelValue=3018", "--signal",
      "Mode=2",
    ],
    true,
  )
  check_cli(
    "physical encode maps values to A2BC",
    [
      "run", "cmd/moondbc", "--", "encode", "testdata/minimal.dbc",
      "--message", "Minimal", "--physical", "--signal",
      "IntelValue=1508", "--signal", "Mode=2",
    ],
    true,
    expected_output="payload=A2BC",
  )
  check_cli(
    "physical encode rejects non-representable values",
    [
      "run", "cmd/moondbc", "--", "encode", "testdata/minimal.dbc",
      "--message", "Minimal", "--physical", "--signal",
      "IntelValue=1508.25", "--signal", "Mode=2",
    ],
    false,
  )
  check_cli(
    "standard 0x123 frame selects standard message",
    [
      "run", "cmd/moondbc", "--", "decode", "testdata/extended_can.dbc",
      "--frame-id", "291", "--data", "11",
    ],
    true,
    expected_output="name=StandardFrame",
  )
  check_cli(
    "extended 0x123 frame selects extended message",
    [
      "run", "cmd/moondbc", "--", "decode", "testdata/extended_can.dbc",
      "--frame-id", "291", "--data", "22", "--extended",
    ],
    true,
    expected_output="name=ExtendedFrame",
  )
  check_cli(
    "extended frame JSON reports on-bus ID and frame type",
    [
      "run", "cmd/moondbc", "--", "decode", "testdata/extended_can.dbc",
      "--frame-id", "291", "--data", "22", "--extended", "--json",
    ],
    true,
    expected_output="\"frame_id\":291,\"extended\":true,\"message\":\"ExtendedFrame\"",
  )
  check_cli(
    "candump log decodes ordered frames as NDJSON",
    [
      "run", "cmd/moondbc", "--", "decode-log", "testdata/candump.dbc",
      "testdata/candump.log",
    ],
    true,
    expected_output="\"line\":1,\"timestamp\":\"1.000001\",\"interface\":\"can0\"",
  )
  check_cli(
    "candump rejects CAN FD with source line diagnostic",
    [
      "run", "cmd/moondbc", "--", "decode-log", "testdata/candump.dbc",
      "testdata/candump_bad.log",
    ],
    false,
  )
  check_cli(
    "invalid CLI arguments fail",
    ["run", "cmd/moondbc", "--", "decode", "testdata/minimal.dbc", "--frame-id", "256"],
    false,
  )
  check_cli(
    "missing disk file fails",
    ["run", "cmd/moondbc", "--", "validate", "testdata/not-found.dbc"],
    false,
  )
  println("PASS file-level CLI integration: 16 checks")
}
